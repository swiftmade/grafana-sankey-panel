{
  "name": "grafana-sankey-panel",
  "version": "1.1.3",
  "description": "Sankey Panel Plugin for Grafana with simplified 3-column data parser",
  "license": "Apache-2.0",
  "repository": "https://github.com/swiftmade/grafana-sankey-panel",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "npx cypress install && npx grafana-e2e run",
    "e2e:update": "npx cypress install && npx grafana-e2e run --update-screenshots",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "start": "npm run dev",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "author": {
    "name": "Swiftmade OÜ",
    "email": "hello@swiftmade.co",
    "url": "https://swiftmade.co"
  },
  "contributors": [
    {
      "name": "NetSage Project",
      "email": "khturner2@es.net"
    }
  ],
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "8.0.6",
    "@grafana/i18n": "^12.2.0",
    "@grafana/runtime": "9.3.8",
    "@grafana/schema": "^12.2.0",
    "@grafana/ui": "8.0.6",
    "d3": ">=7.0.0 <8.0.0",
    "d3-sankey": "0.12.3",
    "grafana-plugin-support": "latest",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tslib": "2.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.7",
    "@grafana/e2e": "9.3.8",
    "@grafana/e2e-selectors": "9.3.8",
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/tsconfig": "^2.0.0",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/d3": "7.0.0",
    "@types/d3-sankey": "0.11.2",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.188",
    "@types/node": "^20.8.7",
    "@types/react": "17.0.42",
    "@types/react-dom": "17.0.14",
    "@types/testing-library__jest-dom": "5.14.8",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "emotion": "11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.5.0",
